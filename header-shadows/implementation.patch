+
+void main() {
+  for (final brightness in Brightness.values) {
+    testWidgets(
+      'Header ${brightness.name}: secondary idle/hover and no active fill',
+      (t) async {
+        final theme = official(brightness);
+        var calls = 0;
+        await t.pumpWidget(
+          host(
+            theme,
+            DshButton(
