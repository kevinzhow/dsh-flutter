{
  "sourcePackage": "@deepseek-ai/dsh-client-ui-primitives",
  "version": "0.2.1-rc.2",
  "rules": {
    "Menu.module.css": {
      ".root": {
        "position": "relative",
        "display": "inline-flex"
      },
      ".list, .submenu": {
        "box-sizing": "border-box",
        "padding": "4px",
        "display": "flex",
        "flex-direction": "column",
        "gap": "0",
        "border": "0",
        "--dsw-elevation-stroke-color": "var(--dsw-alias-border-l1)",
        "box-shadow": "var(--dsw-elevation-prominent)",
        "--dsh-scrollbar-thumb": "var(--dsw-alias-scrollbar-bg-l2)",
        "--dsh-scrollbar-thumb-hover": "var(--dsw-alias-scrollbar-hover-l2)"
      },
      ".list": {
        "position": "absolute",
        "top": "calc(100% + 4px)",
        "left": "0",
        "z-index": "100",
        "min-width": "144px",
        "max-width": "360px"
      },
      ".portal": {
        "position": "fixed",
        "top": "auto",
        "left": "auto",
        "z-index": "1100"
      },
      ".sideTop": {
        "top": "auto",
        "bottom": "calc(100% + 4px)"
      },
      ".alignEnd": {
        "left": "auto",
        "right": "0"
      },
      ".scrollable": {
        "max-height": "calc(100vh - 12px - max(12px, var(--dsh-frame-overlay-top, 12px)))"
      },
      ".viewport": {
        "display": "flex",
        "flex-direction": "column",
        "min-height": "0"
      },
      ".scrollable .viewport": {
        "overflow-y": "auto"
      },
      ".footer": {
        "flex": "none",
        "display": "flex",
        "flex-direction": "column",
        "margin-top": "3px",
        "padding-top": "3px",
        "border-top": "0.5px solid var(--dsw-alias-border-l2)"
      },
      ".itemWrap": {
        "position": "relative"
      },
      ".item": {
        "display": "flex",
        "align-items": "center",
        "gap": "6px",
        "width": "100%",
        "min-height": "34px",
        "padding": "6px 8px",
        "border": "none",
        "border-radius": "var(--dsw-radius-md)",
        "background": "transparent",
        "cursor": "pointer",
        "font-size": "13px",
        "line-height": "20px",
        "color": "var(--dsw-alias-label-primary)",
        "text-align": "left"
      },
      ".item:hover:not(:disabled)": {
        "background": "var(--dsw-alias-interactive-bg-hover)"
      },
      ".item:focus-visible:not(:disabled)": {
        "background": "var(--dsw-alias-interactive-bg-hover)",
        "outline": "none"
      },
      ".denseList .item": {
        "min-height": "30px",
        "padding-block": "4px"
      },
      ".denseList .label": {
        "padding-block": "3px"
      },
      ".list.compactList, .submenu.compactList": {
        "min-width": "156px",
        "padding": "4px"
      },
      ".compactList .item": {
        "min-height": "24px",
        "gap": "5px",
        "padding": "2px 6px",
        "border-radius": "var(--dsw-radius-sm)",
        "font-size": "11px",
        "line-height": "17px"
      },
      ".compactList .itemIcon": {
        "width": "12px",
        "height": "12px"
      },
      ".compactList .separator": {
        "margin": "2px"
      },
      ".compactList .label": {
        "padding": "3px 6px",
        "font-size": "10px",
        "line-height": "15px"
      },
      ".item:disabled": {
        "opacity": "0.4",
        "cursor": "not-allowed"
      },
      ".itemIcon": {
        "display": "inline-flex",
        "flex": "none",
        "width": "14px",
        "height": "14px",
        "align-items": "center",
        "justify-content": "center",
        "color": "var(--dsw-alias-menu-icon)"
      },
      ".itemIcon svg, .check": {
        "width": "14px",
        "height": "14px"
      },
      ".compactList .itemIcon svg, .compactList .check": {
        "width": "12px",
        "height": "12px"
      },
      ".itemLabel": {
        "flex": "1",
        "min-width": "0",
        "overflow": "hidden",
        "text-overflow": "ellipsis",
        "white-space": "nowrap"
      },
      ".shortcut": {
        "flex": "none",
        "margin-inline-start": "auto"
      },
      ".shortcut .shortcutKeys": {
        "color": "var(--dsw-alias-label-caption)",
        "font-size": "11px",
        "line-height": "16px"
      },
      ".check": {
        "flex": "none",
        "color": "var(--dsw-alias-label-primary)"
      },
      ".selected": {
        "background": "transparent"
      },
      ".selectedFill": {
        "background": "var(--dsw-alias-interactive-bg-hover)"
      },
      ".danger": {
        "color": "var(--dsw-alias-state-error-primary)"
      },
      ".danger .itemIcon": {
        "color": "var(--dsw-alias-state-error-primary)"
      },
      ".danger:hover:not(:disabled)": {
        "background": "var(--dsw-alias-interactive-bg-hover-danger)"
      },
      ".danger:focus-visible:not(:disabled)": {
        "background": "var(--dsw-alias-interactive-bg-hover-danger)",
        "outline": "none"
      },
      ".label": {
        "padding": "6px 8px",
        "font-size": "11px",
        "line-height": "15px",
        "color": "var(--dsw-alias-label-tertiary)"
      },
      ".separator": {
        "height": "0.5px",
        "margin": "3px 2px",
        "background": "var(--dsw-alias-border-l2)"
      },
      ".separator + .separator, .separator + .itemWrap > .separator:first-child, .itemWrap:first-child > .separator:first-child": {
        "display": "none"
      },
      ".submenu": {
        "position": "absolute",
        "top": "auto",
        "bottom": "-4px",
        "left": "calc(100% + 10px)",
        "z-index": "101",
        "min-width": "163px"
      },
      ".submenu::before": {
        "content": "''",
        "position": "absolute",
        "top": "0",
        "bottom": "0",
        "left": "-10px",
        "width": "10px"
      }
    },
    "MenuSurface.module.css": {
      ".surface, .backing": {
        "border-radius": "var(--dsw-radius-lg)"
      },
      ".compact": {
        "border-radius": "var(--dsw-radius-md)"
      },
      ":where(.surface)": {
        "position": "relative"
      },
      ".surface": {
        "anchor-name": "var(--dsh-menu-anchor)",
        "isolation": "isolate"
      },
      ".material": {
        "position": "absolute",
        "inset": "0",
        "z-index": "-1",
        "border-radius": "inherit",
        "background": "var(--dsw-menu-surface-fill)",
        "backdrop-filter": "var(--dsw-menu-backdrop-filter)",
        "pointer-events": "none"
      },
      ".backing": {
        "display": "none"
      },
      ":global(html[data-platform='darwin']) .backing": {
        "display": "block",
        "position": "fixed",
        "position-anchor": "var(--dsh-menu-anchor)",
        "top": "anchor(top)",
        "left": "anchor(left)",
        "width": "anchor-size(width, 0px)",
        "height": "anchor-size(height, 0px)",
        "z-index": "-1",
        "background": "var(--dsw-alias-bg-base)",
        "pointer-events": "none"
      }
    },
    "MenuGroup.module.css": {
      ".group": {
        "position": "relative"
      },
      ".start": {
        "position": "absolute",
        "top": "0",
        "left": "0",
        "width": "1px",
        "height": "1px",
        "opacity": "0",
        "pointer-events": "none"
      },
      ".group + .group": {
        "margin-top": "3px"
      },
      ".heading": {
        "position": "sticky",
        "top": "0",
        "z-index": "1",
        "padding": "4px 7px 2px",
        "background": "transparent",
        "color": "var(--dsw-alias-label-tertiary)",
        "font-size": "11px",
        "line-height": "16px",
        "font-weight": "500"
      },
      ".heading[data-stuck]": {
        "background": "var(--dsw-alias-menu-group-header-fill)"
      },
      ":global(html:not([data-platform='darwin'])) .heading": {
        "border-radius": "var(--dsw-radius-md)"
      }
    },
    "PluginManagerPage.module.css": {
      ".addMenu": {
        "width": "320px",
        "max-width": "calc(100vw - 48px)"
      },
      ".addMenu [role=menuitem]": {
        "box-sizing": "border-box",
        "gap": "10px",
        "height": "72px",
        "padding": "6px 12px"
      },
      ".addMenuItem": {
        "white-space": "normal",
        "flex-direction": "column",
        "gap": "2px",
        "display": "flex"
      },
      ".addMenuDescription": {
        "overflow-wrap": "anywhere",
        "max-height": "36px",
        "color": "var(--dsw-alias-label-secondary)",
        "-webkit-line-clamp": "2",
        "-webkit-box-orient": "vertical",
        "font-size": "12px",
        "line-height": "18px",
        "display": "-webkit-box",
        "overflow": "hidden"
      }
    },
    "dockkit.module.css": {
      ".menu": {
        "position": "fixed",
        "z-index": "70",
        "display": "flex",
        "flex-direction": "column",
        "min-width": "96px",
        "padding": "4px",
        "border": "0.5px solid var(--dsw-alias-border-l2)"
      },
      ".menu:not(:has([role='menuitem'], [role='menuitemcheckbox'], [role='menuitemradio']))": {
        "display": "none"
      },
      ".menuItem": {
        "padding": "4px 7px",
        "color": "var(--dsw-alias-label-primary)",
        "font-size": "calc(var(--dsh-content-font-size-secondary, 13px) - 1px)",
        "text-align": "left",
        "background": "transparent",
        "border": "none",
        "border-radius": "var(--dsw-radius-md)",
        "cursor": "pointer"
      },
      ".menuItem:hover": {
        "background": "var(--dsw-alias-interactive-bg-hover)"
      }
    }
  },
  "coverage": "Menu base/dense/compact and dock rows, source surface/footer geometry, generic scrolling viewport with pinned footer and all-row keyboard walk. Submenus, shortcuts, sticky groups and arbitrary-content/macOS backdrop remain explicit follow-up.",
  "portalPlacement": "const MARGIN = $margin; const vw = window.innerWidth; const vh = window.innerHeight; const listEl = listRef.current; const lw = listEl?.offsetWidth ?? 0; const lh = listEl?.offsetHeight ?? 0; let x; let y; if (side === \"right\") { x = r.right + $gap; y = r.top; } else if (align === \"start\") { x = r.left; y = side === \"bottom\" ? r.bottom + $gap : r.top - lh - $gap; } else { x = r.right - lw; y = side === \"bottom\" ? r.bottom + $gap : r.top - lh - $gap; } if (lw > 0) x = Math.min(Math.max(x, MARGIN), vw - lw - MARGIN); if (lh > 0) y = Math.min(Math.max(y, overlayTopMargin(MARGIN)), vh - lh - MARGIN);"
}
