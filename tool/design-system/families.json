  "patterns": {
    "platform-control": "\\b(?:TextButton|ElevatedButton|OutlinedButton|IconButton|PopupMenuButton|DropdownButton|DropdownMenu|Checkbox|Switch|Radio|Slider|AlertDialog|SimpleDialog|Drawer|NavigationRail|NavigationBar|TabBar|Tooltip|SnackBar|TextField|TextFormField|CupertinoButton|CupertinoTextField|CupertinoSwitch)\\s*\\(",
    "duplicate-button": "\\bDshIconButton\\s*\\(",
    "duplicate-input": "\\bDshFieldInput\\s*\\(",
    "duplicate-tag": "\\b(?:_Tag|_PresetTag)\\s*\\(",
    "manual-metric": "\\b(?:height|width|fontSize|radius|horizontalPadding|size|gap|decorationThickness)\\s*:\\s*(?:\\d+\\.?\\d*)\\b|\\bBorderRadius\\.circular\\(\\s*\\d",
    "duplicate-menu": "\\b(?:_MenuSurface|_MenuItem)\\s*\\("
  },
  "remediation": {
    "platform-control": "use the canonical Dsh family wrapper; allowlisted wrappers need a source-backed reason",
    "duplicate-button": "migrate to DshButton with the source icon-action recipe",
    "duplicate-input": "consolidate through the canonical DshInput atom",
    "duplicate-tag": "use DshTag with its published tone recipe",
    "manual-metric": "generate a source recipe or use its theme token; avoid page overrides",
    "duplicate-menu": "use DshMenuSurface/DshMenuItemButton with the published dock profile; do not copy generic row geometry"
  },
  "wrapperAllowlist": {
    "platform-control": {
      "packages/dsh_ui/lib/src/dsh_text_field.dart": "Canonical general-purpose native text-editing wrapper",
      "packages/dsh_ui/lib/src/dsh_settings.dart": "Legacy settings text editor; retire when its settings variant uses DshTextField"
    }
  },
