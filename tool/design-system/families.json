        "packages/dsh_ui/lib/src/dsh_risk_dialog.dart"
      ],
      "migrationStatus": "published Modal layer, headed content, preset reader and controlled risk profile; source viewport mask, keyboard/composition guards, independent reader panels and scrollable risk content with a fixed footer; settings/shortcut routes and other caller profiles remain pending",
      "pendingDuplicates": [
        "SettingsShell and shortcut reference routes -> shared Modal layer",
        "Raw schedule deletion dialog -> generated Modal profile"
      ]
    },
    {
      "name": "text-inputs",
