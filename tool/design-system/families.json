{
  "schema": "dsh-design-families/1",
  "families": [
    {
      "name": "buttons",
      "canonical": [
        "packages/dsh_ui/lib/src/dsh_button.dart"
      ],
      "migrationStatus": "primitive variants and add/icon/info profiles generated from published CSS; local round icon adaptation still pending",
      "pendingDuplicates": [
        "DshIconButton -> DshButton icon-action recipe"
      ]
    },
    {
      "name": "menus",
      "canonical": [
        "packages/dsh_ui/lib/src/dsh_menu.dart",
        "packages/dsh_ui/lib/src/dsh_menu_surface.dart",
        "packages/dsh_ui/lib/src/dsh_menu_item.dart",
        "packages/dsh_ui/lib/src/dsh_menu_footer.dart",
        "packages/dsh_ui/lib/src/dsh_menu_follower.dart",
        "packages/dsh_ui/lib/src/dsh_menu_group.dart"
      ],
      "migrationStatus": "published menu/dock rows, material, footer, viewport fitting, sticky groups, keyboard walk and effective shortcut presentation; workspace picker uses canonical card; live session shortcut wiring, submenus and arbitrary-content/macOS backing pending",
      "pendingDuplicates": []
    },
    {
      "name": "popovers",
      "canonical": [
        "packages/dsh_ui/lib/src/dsh_anchored_panel.dart"
      ],
      "migrationStatus": "inventory only; recipe migration pending",
      "pendingDuplicates": []
    },
    {
      "name": "tooltips",
      "canonical": [
        "packages/dsh_ui/lib/src/dsh_tooltip.dart"
      ],
      "migrationStatus": "published tooltip and keycap recipes, anchor fitting, focus/hover and click dismissal; dynamic label resolvers and document-level portal behavior remain to be audited",
      "pendingDuplicates": []
    },
    {
      "name": "dialogs",
      "canonical": [
        "packages/dsh_ui/lib/src/dsh_presentation.dart",
        "packages/dsh_ui/lib/src/dsh_dialog_reader.dart",
        "packages/dsh_ui/lib/src/dsh_reader_markdown.dart",
