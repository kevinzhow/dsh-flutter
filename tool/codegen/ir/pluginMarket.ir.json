    {
      "name": "setIndexes",
      "hostName": "setIndexes",
      "mode": "unary",
      "cancellable": false,
      "params": [
        {
          "name": "urls",
          "optional": false,
          "type": {
            "k": "arr",
            "of": {
              "k": "str"
            }
          }
        }
      ],
      "result": {
        "k": "void"
      },
      "doc": "Replace the configured index sources through Settings, without remounting this service. `plugin-market/changed` announces the committed list. A URL already configured is kept as written, so a client can add or remove sources beside one that `listIndexes` reports as unusable."
    },
    {
      "name": "search",
      "hostName": "search",
      "mode": "unary",
      "cancellable": false,
      "params": [
        {
          "name": "url",
          "optional": false,
