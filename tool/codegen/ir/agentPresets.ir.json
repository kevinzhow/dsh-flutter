{
  "irVersion": 1,
  "kind": "remote-namespace",
  "namespace": "agentPresets",
  "package": "packages/preset/agent-preset-registry",
  "typescript": "6.0.3",
  "inputs": [
    "packages/preset/agent-preset-registry/src/index.ts",
    "packages/preset/agent-preset-registry/src/types.ts"
  ],
  "methods": [
    {
      "name": "list",
      "hostName": "remoteExportList",
      "mode": "unary",
      "cancellable": false,
      "params": [],
      "result": {
        "k": "ref",
        "name": "AgentPresetRoster"
      },
      "doc": "Read the selection roster."
    },
    {
      "name": "read",
      "hostName": "readDocument",
      "mode": "unary",
      "cancellable": false,
      "params": [
        {
          "name": "agentPreset",
          "optional": false,
          "type": {
            "k": "str"
          }
        }
      ],
      "result": {
        "k": "ref",
        "name": "AgentPresetDocument"
      },
      "doc": "Read one declaration's child plugin list as YAML, for viewing only."
    },
    {
      "name": "select",
      "hostName": "select",
      "mode": "unary",
      "cancellable": false,
      "params": [
        {
          "name": "agentId",
          "optional": false,
          "type": {
            "k": "str",
            "brand": true
          },
          "lookup": "agent"
        },
        {
          "name": "agentPreset",
          "optional": false,
          "type": {
            "k": "str"
          }
        }
      ],
      "result": {
        "k": "str"
      },
      "doc": "Select a preset before a session starts its first turn. A Session whose log records the preset and whose Agent runs its current revision keeps its composition; nothing is logged or announced."
    }
  ],
  "decls": {
    "AgentPresetDocument": {
      "k": "obj",
      "props": [
        {
          "name": "agentPreset",
          "optional": false,
          "type": {
            "k": "str"
          },
          "doc": "The preset the composition belongs to."
        },
        {
          "name": "content",
          "optional": false,
          "type": {
            "k": "str"
          },
          "doc": "The declared child plugin list as entry-list YAML, `!!js` expressions included."
        },
        {
          "name": "name",
          "optional": true,
          "type": {
            "k": "str"
          },
          "doc": "Display name the preset published."
        },
        {
          "name": "description",
          "optional": true,
          "type": {
            "k": "str"
          },
          "doc": "One sentence on what this preset is for."
        }
      ],
      "source": "packages/preset/agent-preset-registry/src/types.ts",
      "doc": "One preset's declared composition, rendered for reading."
    },
    "AgentPresetRoster": {
      "k": "obj",
      "props": [
        {
          "name": "presets",
          "optional": false,
          "type": {
            "k": "arr",
            "of": {
              "k": "ref",
              "name": "AgentPresetRow"
            }
          },
          "doc": "Every current declaration, including activation failures."
        }
      ],
      "source": "packages/preset/agent-preset-registry/src/types.ts",
      "doc": "The roster one deployment currently supplies."
    },
    "AgentPresetRow": {
      "k": "obj",
      "props": [
        {
          "name": "id",
          "optional": false,
          "type": {
            "k": "str"
          },
          "doc": "Stable identifier; also the label's fallback."
        },
        {
          "name": "isDefault",
          "optional": false,
          "type": {
            "k": "bool"
          },
          "doc": "Whether a session naming no preset composes this one."
        },
        {
          "name": "name",
          "optional": true,
          "type": {
            "k": "str"
          },
          "doc": "Display name the preset published."
        },
        {
          "name": "description",
          "optional": true,
          "type": {
            "k": "str"
          },
          "doc": "One sentence on what this preset is for."
        },
        {
          "name": "broken",
          "optional": true,
          "type": {
            "k": "str"
          },
          "doc": "Why this preset cannot compose a session; absent when it can."
        }
      ],
      "source": "packages/preset/agent-preset-registry/src/types.ts",
      "doc": "One declared preset as a client reads it."
    }
  },
  "notes": [],
  "skipped": []
